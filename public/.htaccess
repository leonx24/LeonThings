# ----------------------------------------------------------------------
# 1. React Router SPA Fallback (DirectAdmin Apache / LiteSpeed)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Jangan proses ulang jika sudah mengarah ke index.html
  RewriteRule ^index\.html$ - [L]

  # Jika file, direktori, atau symlink fisik ada (assets, webp, robots.txt, dll), buka langsung
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Semua route SPA lainnya (misal: /project/leonx) diarahkan ke index.html
  RewriteRule . /index.html [L]
</IfModule>

# ----------------------------------------------------------------------
# 2. Kompresi Gzip / Deflate agar Bundle Three.js & CSS Cepat Dimuat
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ----------------------------------------------------------------------
# 3. Browser Caching (Immutable untuk Hashed Assets, Fresh untuk HTML)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # Pastikan index.html selalu ambil versi terbaru saat kamu upload build baru
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>

  # Cache 1 tahun untuk file aset statis yang punya hash dari Vite
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
